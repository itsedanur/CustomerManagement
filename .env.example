# PostgreSQL Database Configuration
POSTGRES_DB=customer_management
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=change_me_in_production

# JWT Token Security Configuration
JWT_SECRET=change_me_to_a_long_random_string_in_production

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# Admin Bootstrap Account Settings
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=admin
BOOTSTRAP_ADMIN_FIRSTNAME=System
BOOTSTRAP_ADMIN_LASTNAME=Admin

# Active Spring Profile (prod / dev)
SPRING_PROFILES_ACTIVE=prod

# Redis Configuration (Docker or Host)
REDIS_HOST=redis
REDIS_PORT=6379

# Login Rate Limiting Configuration
LOGIN_RATE_LIMIT=5
LOGIN_RATE_DURATION=60

